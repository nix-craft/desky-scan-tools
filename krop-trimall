#!/bin/sh
# Patched krop 0.6.0 with "Trim Margins on all pages" (see ~/src/krop-trimall)
if [ -f /run/.containerenv ] || [ -n "$CONTAINER_ID" ]; then
  exec host-spawn env PYTHONPATH="$HOME/src/krop-trimall" /usr/bin/python3 -m krop "$@"
fi
PYTHONPATH="$HOME/src/krop-trimall" exec /usr/bin/python3 -m krop "$@"
